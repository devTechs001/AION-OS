# AION OS Kernel Configuration
# Generated by AION build system

# Architecture Configuration
CONFIG_ARCH_X86_64=y
CONFIG_SMP=y
CONFIG_NUMA=n

# General Setup
CONFIG_EXPERT=n
CONFIG_KERNEL_START=0x100000
CONFIG_PHYSICAL_ALIGN=0x1000000
CONFIG_LOG_BUF_SHIFT=18

# CPU Features
CONFIG_CPU_MITIGATIONS=y
CONFIG_HIGH_RES_TIMERS=y

# Memory Management
CONFIG_FLATMEM_MANUAL=y
CONFIG_MEMORY_HOTPLUG=n
CONFIG_SELECT_MEMORY_MODEL=y
CONFIG_FLATMEM=y
CONFIG_FLAT_NODE_MEM_MAP=y
CONFIG_PAGEFLAGS_EXTENDED=y
CONFIG_ARCH_HAS_PTE_DEVMAP=y

# Process Management
CONFIG_TASK_SIZE_MAX=0xc000000000000000
CONFIG_MMU_GATHER_TABLE_ONE=y
CONFIG_MMU_GATHER_RCU_TABLES=y

# Executable Format
CONFIG_BINFMT_ELF=y
CONFIG_ARCH_BINFMT_ELF_STATE=y
CONFIG_ARCH_USE_GNU_PROPERTY=y
CONFIG_ARCH_HAVE_ELF_PROT=y

# AI Features
CONFIG_AI_INTEGRATION=y
CONFIG_AI_SCHEDULER=y
CONFIG_AI_MEMORY_MANAGER=y

# Networking
CONFIG_NET=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_IP_MULTICAST=y

# Device Drivers
CONFIG_PCI=y
CONFIG_PCI_GOANY=y
CONFIG_PCI_GOARCH=y
CONFIG_PCI_GOMETHOD=y
CONFIG_PCI_GOHOST=y

# File Systems
CONFIG_MSDOS_FS=y
CONFIG_PROC_FS=y
CONFIG_PROC_PID_ARCH_STATUS=y
CONFIG_PROC_PAGE_MONITOR=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y

# Security
CONFIG_KEYS=y
CONFIG_PERSISTENT_KEYRINGS=y
CONFIG_ENCRYPTED_KEYS=y
CONFIG_SECURITY=y
CONFIG_SECURITY_NETWORK=y

# Kernel Debugging
CONFIG_DEBUG_KERNEL=y
CONFIG_DEBUG_INFO=y
CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT=y