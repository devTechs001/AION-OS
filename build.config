# AION OS Build Configuration
# Main build settings

# Compiler settings
CC=gcc
CXX=g++
AS=nasm
LD=ld

# Architecture
ARCH=x86_64

# Build directories  
BUILD_DIR=build
KERNEL_DIR=kernel
USERLAND_DIR=userspace
LIB_DIR=lib

# Compiler flags
CFLAGS=-m64 -ffreestanding -fno-stack-protector -fno-exceptions -fno-rtti -nostdlib
CXXFLAGS=-m64 -ffreestanding -fno-stack-protector -fno-exceptions -fno-rtti -nostdlib
ASFLAGS=-f elf64

# Output settings
KERNEL_OUTPUT=$(BUILD_DIR)/aion-kernel.bin
ISO_OUTPUT=$(BUILD_DIR)/aion-os.iso

# Feature flags
ENABLE_AI=true
ENABLE_NETWORKING=true
ENABLE_GRAPHICS=false
ENABLE_SECURITY=true